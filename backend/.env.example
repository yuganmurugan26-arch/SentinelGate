# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# The Gmail address you'll send OTP emails from
GMAIL_USER=your-email-here

# A 16-character Gmail "App Password" (NOT your normal Gmail password)
# See README.md in this folder for how to generate one.
GMAIL_APP_PASSWORD=your-app-password-here
# Port the backend server runs on
PORT=4000

# Optional — only needed if you want users & resources mirrored to Supabase.
# Leave these blank/missing and the app works exactly as before, using only db.json.
# Get these from your Supabase project: Project Settings -> API
 SUPABASE_URL=your-URL-here
SUPABASE_SERVICE_KEY=your-service-role-key-here